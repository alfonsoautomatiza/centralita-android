#!/usr/bin/env bash
# Blocks commits that could leak source code, secrets, or internal details
# into this public documentation repository.
set -euo pipefail

status=0
fail() {
  echo "pre-commit: $1" >&2
  status=1
}

mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR)

for file in "${files[@]}"; do
  case "$file" in
    .gitignore | README.md | index.html | docs/*.md | docs/images/*.png | docs/images/*.jpg | docs/images/*.svg) ;;
    .github/ISSUE_TEMPLATE/*.md | .github/ISSUE_TEMPLATE/config.yml | .githooks/pre-commit) ;;
    *) fail "file not allowed in the public repository: $file" ;;
  esac
done

patterns=(
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
  'gh[pousr]_[A-Za-z0-9_]{20,}'
  'AKIA[0-9A-Z]{16}'
  'AIza[0-9A-Za-z_-]{35}'
  'sk-[A-Za-z0-9]{20,}'
  '(SECRET|PASSWORD|TOKEN|ADMIN_KEY|SIGNING_KEY)[A-Z_]*[[:space:]]*[=:]'
  '\b(10|127)\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\b'
  '\b192\.168\.[0-9]{1,3}\.[0-9]{1,3}\b'
  '\b172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3}\b'
  '/v1/admin'
  '\.env\b'
)

# Optional project-specific denylist kept out of version control.
deny_file="$(git rev-parse --git-dir)/info/deny-terms"
if [[ -f "$deny_file" ]]; then
  while IFS= read -r term; do
    [[ -n "$term" && "$term" != \#* ]] && patterns+=("$term")
  done <"$deny_file"
fi

for file in "${files[@]}"; do
  [[ "$file" == .githooks/pre-commit ]] && continue
  for pattern in "${patterns[@]}"; do
    if git show ":$file" | grep -nEi -- "$pattern" >/dev/null; then
      fail "forbidden content in $file (pattern: $pattern)"
    fi
  done
done

exit "$status"
