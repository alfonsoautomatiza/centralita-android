# Allowlist: this public repository may contain documentation only.
# Everything is ignored unless explicitly re-included below.
*
!*/

!.gitignore
!/README.md
!docs/*.md
!docs/images/*.png
!docs/images/*.jpg
!docs/images/*.svg
!index.html
!.github/ISSUE_TEMPLATE/*.md
!.github/ISSUE_TEMPLATE/config.yml
!.githooks/pre-commit
